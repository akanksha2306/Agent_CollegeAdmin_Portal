# Copy to .env and adjust as needed.
# Matches the docker-compose Postgres service.
DATABASE_URL="postgresql://amp:amp_dev_password@localhost:5432/amp?schema=public"
PORT=4000
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# Secret used to sign session JWTs. Generate a long random string for production.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
