// Prisma schema — the database source of truth.
// Mirrors the PRD §13 data model. Keep enums in sync with shared/src/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  NEW_REQUEST
  IN_REVIEW
  PENDING_DOCUMENTS
  APPROVED
  ACTIVE
  REJECTED
  TERMINATED
}

enum AgentType {
  EDUCATION
  DUAL
}

enum DocumentKey {
  REG
  ASIC
  ID
  PIER
  MARN
}

enum DocumentStatus {
  MISSING
  PENDING
  VERIFIED
}

enum ReferenceOutcome {
  PENDING
  PASSED
}

enum Rating {
  A
  B
  C
  UNRATED
}

enum UserRole {
  ADMIN
  REVIEWER
  AUDITOR
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  email        String       @unique
  name         String
  passwordHash String?
  role         UserRole     @default(REVIEWER)
  createdAt    DateTime     @default(now())
  auditEvents  AuditEvent[]
}

model Agent {
  id          String      @id @default(cuid())
  appId       String      @unique
  business    String
  contactName String
  country     String
  city        String
  email       String
  phone       String
  type        AgentType   @default(EDUCATION)
  abn         String?
  acn         String?
  marn        String?
  onshore     Boolean     @default(false)
  status      AgentStatus @default(NEW_REQUEST)
  rating      Rating      @default(UNRATED)
  certExpiry  DateTime?

  // Review pipeline state (PRD §08)
  stage       Int         @default(1)
  ackSent     Boolean     @default(false)
  ackReplied  Boolean     @default(false)

  // Activation state (PRD §09) — post-approval
  agreementSigned Boolean @default(false)

  submittedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  documents       Document[]
  references      Reference[]
  onboardingTasks OnboardingTask[]
  performance     PerformanceSnapshot[]
  auditEvents     AuditEvent[]
}

model Document {
  id           String         @id @default(cuid())
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      String
  key          DocumentKey
  fileName     String?
  filePath     String? // path to the stored upload on disk
  status       DocumentStatus @default(MISSING)
  verifiedById String?
  verifiedAt   DateTime?

  @@unique([agentId, key])
}

model Reference {
  id             String           @id @default(cuid())
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId        String
  refereeName    String
  cricosProvider String
  outcome        ReferenceOutcome @default(PENDING)
}

model OnboardingTask {
  id          String    @id @default(cuid())
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId     String
  key         String // e.g. "prisms", "asqanet", "collateral", "reregister"
  done        Boolean   @default(false)
  completedAt DateTime?

  @@unique([agentId, key])
}

model PerformanceSnapshot {
  id          String   @id @default(cuid())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId     String
  intake      String
  enrolments  Int      @default(0)
  conversion  Int      @default(0)
  visaRefusal Int      @default(0)
  withdrawals Int      @default(0)
  createdAt   DateTime @default(now())
}

// Append-only audit trail (PRD §13, §01 "audit-readiness by default")
model AuditEvent {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  agentId   String?
  action    String
  entity    String
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())
}
